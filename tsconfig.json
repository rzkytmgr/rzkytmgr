{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["./*"]
        }
    },
    "include": [
        ".astro/types.d.ts",
        "**/*.ts",
        "**/*.tsx",
        "**/*.mts",
        "**/*.astro"
    ],
    "exclude": ["node_modules", "dist"]
}
