---
interface Props {
    id: string;
    title: string;
    linkHref?: string;
    linkLabel?: string;
    class?: string;
}

const {
    id,
    title,
    linkHref,
    linkLabel = "View more",
    class: className,
} = Astro.props;
---

<section id={id} class:list={["pt-32", className]}>
    <div>
        <div class="flex items-center justify-between border-b border-smooth-border pb-3">
            <h2 class="text-xs word-spacing-wide font-medium uppercase tracking-wider text-neutral-500">
                {title}
            </h2>

            {linkHref && (
                <a
                    href={linkHref}
                    class="inline-flex items-center shrink-0 whitespace-nowrap text-xs word-spacing-wide font-medium text-neutral-500 underline-offset-4 decoration-1 transition-colors duration-200 hover:text-journal-accent-text hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-journal-accent"
                >
                    {linkLabel}
                </a>
            )}
        </div>
        <slot />
    </div>
</section>
