---
interface Props {
    item: {
        id: string;
        title: string;
        category: string;
        link: string;
        date: string;
    };
}

const { item: data } = Astro.props;
const year = new Date(data.date).getFullYear();
---

<article class="grid grid-cols-1 gap-3 border-b border-smooth-border py-5 first:pt-8 md:grid-cols-12 md:gap-2">
    <span class="col-span-1 hidden text-xs word-spacing-wide font-medium text-neutral-500 lg:flex">
        {year}
    </span>

    <div class="col-span-11 flex flex-col gap-1">
        <span class="text-xs word-spacing-wide font-medium text-neutral-500">
            <span class="lg:hidden">{year} · </span>
            <span class="text-journal-accent-text">{data.category}</span>
        </span>

        <a
            href={data.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 transition-colors duration-100 hover:text-journal-accent-text focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-journal-accent"
        >
            <h3 class="line-clamp-1 font-bold md:text-lg">{data.title}</h3>

            <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="1em"
                height="1em"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-4 shrink-0"
            >
                <path d="M7 7h10v10"></path>
                <path d="M7 17 17 7"></path>
            </svg>
        </a>
    </div>
</article>
