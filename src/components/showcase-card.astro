---
interface Props {
    showcase: {
        id: string;
        slug: string;
        title: string;
        description: string;
        category: string;
        tech_stack: string[];
        date: string;
        reading_time: string;
        is_archive: boolean;
        thumbnail: string;
        link?: {
            repository?: string;
            preview?: string;
        };
    };
}

const { showcase: data } = Astro.props;
---

<a
    href={`/showcase/${data.slug}`}
    aria-label={`Read more about ${data.title}`}
    class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-journal-accent"
>
    <div class="relative">
        <img
            src={data.thumbnail}
            alt={data.title}
            width="1200"
            height="750"
            loading="lazy"
            decoding="async"
            class="aspect-[16/10] h-auto w-full rounded-lg object-cover"
        />

        {data.is_archive && (
            <span class="absolute top-2 right-2 rounded-full border border-warning-border bg-warning-bg px-2 py-0.5 text-xs word-spacing-wide font-medium text-warning-text shadow-sm">
                unmaintained
            </span>
        )}

        <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 bottom-0 rounded-b-lg bg-gradient-to-t from-black/60 via-black/25 to-transparent px-3 pt-8 pb-3 opacity-0 transition-opacity duration-150 group-hover:opacity-100 motion-reduce:transition-none"
        >
            <p class="text-xs font-semibold text-white">
                {data.tech_stack[0]}
                {data.tech_stack.length > 1 &&
                    `, ${data.tech_stack.length - 1}+`}
            </p>
        </div>
    </div>

    <div class="mt-3 flex min-w-0 items-center justify-between gap-3">
        <h3 class="min-w-0 truncate text-sm font-semibold text-zinc-950 transition-colors duration-100 group-hover:text-journal-accent-text dark:text-zinc-50">
            {data.title}
        </h3>

        <span class="flex-none truncate text-xs word-spacing-wide font-medium text-neutral-500">
            {data.category}
        </span>
    </div>
</a>
