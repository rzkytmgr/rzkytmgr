---
import { socialIcon, icon } from "./icons";

interface Props {
    title: string;
    social: { name: string; href: string }[];
    description: string;
    copyright: string;
}

const { title, social, description, copyright } = Astro.props;

const socialIconButtonClass =
    "inline-flex size-8 items-center justify-center text-neutral-500 transition-colors duration-150 hover:text-journal-accent-text motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-journal-accent";

const gpgButtonClass =
    "inline-flex items-center gap-1.5 rounded-md border border-smooth-border px-3.5 py-2 font-mono text-xs text-neutral-600 transition-colors duration-150 hover:border-journal-accent/50 hover:bg-journal-accent/10 hover:text-journal-accent-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-journal-accent motion-reduce:transition-none dark:text-neutral-400";
---

<hr class="border-smooth-border" />

<footer class="mx-auto w-full max-w-6xl space-y-16 px-5 pt-16 sm:px-6">
    <section class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between md:gap-12">
        <div class="flex flex-col">
            <a
                href="/"
                class="flex w-fit items-center text-sm font-bold tracking-tight transition-colors hover:text-journal-accent-text focus-visible:text-journal-accent-text"
            >
                {title}
            </a>

            <p class="mt-3 max-w-xs text-sm text-neutral-500">{description}</p>

            <ul class="mt-5 flex items-center gap-2.5">
                {social.map(({ name, href }) => (
                    <li>
                        <a
                            href={href}
                            aria-label={name}
                            title={name}
                            target={
                                href.startsWith("http") ? "_blank" : undefined
                            }
                            rel={
                                href.startsWith("http")
                                    ? "noopener noreferrer"
                                    : undefined
                            }
                            class={socialIconButtonClass}
                        >
                            <Fragment set:html={socialIcon(name)} />
                        </a>
                    </li>
                ))}
            </ul>
        </div>

        <div class="flex items-center gap-3">
            <a href="/public.asc.txt" class={gpgButtonClass}>
                <Fragment set:html={icon("key-round", "size-3.5")} />
                GPG Key
            </a>

            <a href="/fingerprint.txt" class={gpgButtonClass}>
                <Fragment set:html={icon("fingerprint", "size-3.5")} />
                Fingerprint
            </a>
        </div>
    </section>

    <section class="flex flex-col gap-4 border-t border-smooth-border py-8 font-mono text-xs text-neutral-500 sm:flex-row sm:items-center sm:justify-between">
        <span>
            © {new Date().getFullYear()} {copyright}
        </span>
        <span>Made in Indonesia</span>
    </section>
</footer>
