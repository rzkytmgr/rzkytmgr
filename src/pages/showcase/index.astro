---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/main-layout.astro";
import ShowcaseCard from "../../components/showcase-card.astro";
import { icon } from "../../components/icons";
import { config } from "../../config";

const showcases = await getCollection("showcase");

const byNewest = (
    a: { data: { date: string } },
    b: { data: { date: string } },
) => Date.parse(b.data.date) - Date.parse(a.data.date);

const items = [...showcases].sort(byNewest);

const categories = [...new Set(items.map((item) => item.data.category))].sort(
    (a, b) => a.localeCompare(b),
);

const pillClass =
    "relative shrink-0 cursor-pointer px-0.5 py-1 text-xs word-spacing-wide font-medium transition-colors duration-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-journal-accent";
const pillIdleClass =
    "text-zinc-700 hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-zinc-50";
const pillActiveClass = "text-zinc-950 dark:text-zinc-50";
---

<MainLayout
    title={config.ui.pages.showcase.heading}
    description={config.ui.pages.showcase.description}
>
    <main
        id="main-content"
        class="m-auto w-full max-w-6xl px-5 pt-0 pb-16 sm:px-6 md:pb-24"
    >
        <h1 class="sr-only">{config.ui.pages.showcase.heading}</h1>

        <div data-showcase-index class="space-y-8">
            <div class="sticky top-16 z-40 flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-smooth-border bg-background/80 py-2 backdrop-blur-md">
                <div
                    role="group"
                    aria-label="Filter projects by category"
                    class="relative -mb-2 flex min-w-0 flex-1 flex-nowrap items-center gap-x-6 self-stretch overflow-x-auto overscroll-x-contain [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
                >
                    <button
                        type="button"
                        data-filter-key="all"
                        aria-pressed="true"
                        class:list={[pillClass, pillActiveClass]}
                    >
                        All <span class="opacity-60">{items.length}</span>
                    </button>

                    {categories.map((category) => (
                        <button
                            type="button"
                            data-filter-key={category.toLowerCase()}
                            aria-pressed="false"
                            class:list={[pillClass, pillIdleClass]}
                        >
                            {category}&nbsp;
                            <span class="opacity-60">
                                {
                                    items.filter(
                                        (item) =>
                                            item.data.category === category,
                                    ).length
                                }
                            </span>
                        </button>
                    ))}

                    <span
                        aria-hidden="true"
                        data-filter-indicator
                        class="absolute bottom-0 h-0.5 bg-journal-accent transition-all duration-300 ease-out motion-reduce:transition-none"
                    ></span>
                </div>

                <div class="flex w-full shrink-0 items-center sm:w-auto">
                    <div class="w-full sm:w-64">
                        <div class="flex items-center gap-2 rounded-full border border-smooth-border bg-neutral-100/60 py-1.5 pr-1.5 pl-3 transition-colors duration-150 hover:border-neutral-400/60 focus-within:border-journal-accent/60 motion-reduce:transition-none">
                            <Fragment
                                set:html={icon(
                                    "search",
                                    "size-3.5 shrink-0 text-neutral-500",
                                )}
                            />

                            <input
                                type="search"
                                data-showcase-search
                                placeholder="search projects..."
                                aria-label="Search projects"
                                autocomplete="off"
                                class="w-full min-w-0 bg-transparent text-xs word-spacing-wide font-medium text-zinc-950 outline-none placeholder:text-neutral-500 [&::-webkit-search-cancel-button]:hidden dark:text-zinc-50"
                            />

                            <button
                                type="button"
                                aria-label="Clear search"
                                data-clear-search
                                hidden
                                class="-my-0.5 shrink-0 cursor-pointer rounded-full p-1 text-neutral-500 transition-colors duration-100 hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-journal-accent dark:hover:text-zinc-50"
                            >
                                <Fragment set:html={icon("x", "size-3")} />
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-10 lg:grid-cols-[26rem_minmax(0,1fr)] lg:gap-14">
                <aside
                    aria-label="Project preview"
                    class="hidden lg:sticky lg:top-24 lg:block lg:self-start"
                >
                    <div data-preview-slot>
                        {items.map((entry, index) => (
                            <div
                                data-preview-panel={entry.data.id}
                                hidden={index !== 0}
                            >
                                <div>
                                    <ShowcaseCard
                                        showcase={entry.data}
                                        featured={true}
                                        showThumbnail={true}
                                    />
                                </div>
                            </div>
                        ))}
                    </div>
                </aside>

                <ul
                    class="border-t border-smooth-border lg:border-t-0"
                    data-showcase-rows
                >
                    {items.map((entry, index) => (
                        <li
                            class="border-b border-smooth-border"
                            data-showcase-row
                            data-project-id={entry.data.id}
                            data-filter-tag={entry.data.category.toLowerCase()}
                            data-search={`${entry.data.title} ${entry.data.description} ${entry.data.category}`.toLowerCase()}
                        >
                            <button
                                type="button"
                                class="group/row flex w-full cursor-pointer items-baseline gap-4 py-5 text-left md:gap-6 md:py-6"
                            >
                                <span
                                    aria-hidden="true"
                                    data-row-index
                                    class="text-xs word-spacing-wide text-neutral-400 transition-colors duration-100 motion-reduce:transition-none dark:text-neutral-600"
                                >
                                    {String(index + 1).padStart(2, "0")}
                                </span>

                                <span
                                    data-row-title
                                    class="flex-1 text-xl leading-tight font-semibold tracking-tight text-neutral-400 transition-colors duration-100 motion-reduce:transition-none group-hover/row:text-zinc-950 dark:text-neutral-500 dark:group-hover/row:text-zinc-50"
                                >
                                    {entry.data.title}
                                </span>

                                {entry.data.is_archive && (
                                    <span class="shrink-0 rounded-full border border-warning-border bg-warning-bg px-2.5 py-0.5 text-xs word-spacing-wide font-medium text-warning-text">
                                        unmaintained
                                    </span>
                                )}

                                <span class="hidden max-w-40 truncate text-xs word-spacing-wide font-medium text-neutral-500 md:block">
                                    {entry.data.category}
                                </span>

                                <Fragment
                                    set:html={icon(
                                        "arrow-up-right",
                                        "size-4 shrink-0 self-center text-neutral-400 transition-all duration-100 group-hover/row:-translate-y-0.5 group-hover/row:translate-x-0.5 group-hover/row:text-journal-accent-text motion-reduce:transition-none motion-reduce:group-hover/row:translate-x-0 motion-reduce:group-hover/row:translate-y-0",
                                    )}
                                />
                            </button>
                        </li>
                    ))}
                </ul>
            </div>

            <p data-empty-message hidden class="text-sm text-neutral-500">
                No projects match your search or filter.
            </p>
        </div>

        <script src="../../scripts/showcase-index.ts"></script>
    </main>
</MainLayout>
