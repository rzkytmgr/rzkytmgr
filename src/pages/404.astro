---
import MainLayout from "../layouts/main-layout.astro";
import { icon } from "../components/icons";
---

<MainLayout title="404 — Page not found">
    <main
        id="main-content"
        class="m-auto w-full max-w-6xl px-5 py-20 sm:px-6 md:py-32"
    >
        <div class="relative flex min-h-[60vh] flex-col items-center justify-center px-5 py-20 text-center">
            <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 font-serif text-[clamp(8rem,24vw,18rem)] leading-none tracking-[-0.03em] text-zinc-950/[0.045] select-none dark:text-zinc-50/[0.06]"
            >
                404
            </div>

            <div class="relative z-10">
                <div class="space-y-5">
                    <p class="font-mono text-xs uppercase tracking-wider text-neutral-500">
                        Error 404
                    </p>

                    <h1 class="text-4xl font-bold tracking-tight text-zinc-950 md:text-5xl dark:text-zinc-50">
                        This page could not be found
                    </h1>

                    <p class="mx-auto max-w-md text-zinc-600 dark:text-zinc-400">
                        The page you are looking for might have been moved,
                        renamed, or does not exist.
                    </p>

                    <div class="pt-2">
                        <a
                            href="/"
                            class="group inline-flex items-center gap-2 border-b border-dashed border-zinc-700 py-1 text-sm font-medium text-zinc-700 transition-colors hover:text-journal-accent-text dark:border-zinc-300 dark:text-zinc-300"
                        >
                            Back to home
                            <Fragment
                                set:html={icon(
                                    "move-right",
                                    "size-3 transition-transform group-hover:translate-x-1",
                                )}
                            />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</MainLayout>
