---
import "../styles/global.css";

import { config } from "../config";
import { NAV_ITEMS } from "../navigation";
import Footer from "../components/footer.astro";
import Navbar from "../components/navbar.astro";
import Sidebar from "../components/sidebar.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description = config.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html
    lang="en"
    data-theme="clean-light"
    data-scroll-behavior="smooth"
    class="scroll-smooth"
>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="icon" href="/favicon.ico" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={config.title}
            href={new URL(config.rss, Astro.site)}
        />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={config.title} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="en_US" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <script is:inline>
            (function () {
                try {
                    var stored = localStorage.getItem("theme");
                    var isDaytime =
                        (new Date().getHours() >= 6) &
                        (new Date().getHours() < 18);
                    var theme =
                        stored === "clean-light" || stored === "charcoal"
                            ? stored
                            : isDaytime
                              ? "clean-light"
                              : "charcoal";
                    document.documentElement.setAttribute("data-theme", theme);
                } catch (e) {}
            })();
        </script>
    </head>
    <body class="min-h-screen overflow-x-hidden bg-background font-sans text-foreground antialiased transition-colors duration-200 selection:bg-journal-accent/25">
        <a
            href="#main-content"
            class="fixed left-4 top-4 z-[100] -translate-y-20 rounded-md border border-smooth-border bg-surface px-4 py-2 font-mono text-xs text-journal-accent-text shadow-lg transition-transform duration-150 focus-visible:translate-y-0"
        >
            Skip to content
        </a>

        <Sidebar items={NAV_ITEMS} />

        <div id="app">
            <Navbar title={config.title} items={NAV_ITEMS} />

            <slot />

            <Footer
                title={config.title}
                social={[
                    ...config.author.social,
                    { name: "Email", href: `mailto:${config.author.email}` },
                    { name: "RSS", href: config.rss },
                ]}
                description={config.ui.footer.description}
                copyright={config.author.name}
            />
        </div>
        <script is:inline>
            document
                .getElementById("theme-toggle")
                ?.setAttribute(
                    "aria-pressed",
                    String(
                        document.documentElement.getAttribute("data-theme") ===
                            "charcoal",
                    ),
                );
        </script>
        <script src="../scripts/ui.ts"></script>
    </body>
</html>
